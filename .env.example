# KNET Payment Gateway (legacy PG, matches petstorekuwait.com flow)
# Provide these values in your deployment environment (Vercel) or .env.local
#
# The source site redirects to https://www.kpay.com.kw/kpg/paymentpage.htm?PaymentID=<id>
# after a server-side initiation against the KNET PaymentInitHTTP servlet.
# Credentials come from your merchant resource.cgn file.

# Full initiation URL of your KNET gateway (from resource.cgn webaddress + context)
KNET_INIT_URL=https://www.kpay.com.kw/kpg/servlet/PaymentInitHTTPServlet

# Merchant credentials from resource.cgn
KNET_MERCHANT_ID=
KNET_MERCHANT_PASSWORD=

# Public HTTPS URLs that KNET POSTs back to (must be the deployed origin, e.g. Vercel)
KNET_RESPONSE_URL=https://YOUR-DOMAIN/api/knet/response
KNET_ERROR_URL=https://YOUR-DOMAIN/api/knet/error

# The customer-facing KNET payment page (defaults to the kpay.com.kw one)
# KNET_PAYMENT_PAGE_URL=https://www.kpay.com.kw/kpg/paymentpage.htm
