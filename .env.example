# KNET Payment Gateway (legacy PG, matches petstorekuwait.com flow)
# Provide these values in your deployment environment (Vercel) or .env.local
#
# The source site redirects to https://www.kpay.com.kw/kpg/paymentpage.htm?PaymentID=<id>
# after a server-side initiation against the KNET PaymentInitHTTP servlet.
# Credentials come from your merchant resource.cgn file.

# Full initiation URL of your KNET gateway (from resource.cgn webaddress + context)
KNET_INIT_URL=https://www.kpay.com.kw/kpg/servlet/PaymentInitHTTPServlet

# Merchant credentials from resource.cgn
KNET_MERCHANT_ID=
KNET_MERCHANT_PASSWORD=

# Public HTTPS URLs that KNET POSTs back to (must be the deployed origin, e.g. Vercel)
KNET_RESPONSE_URL=https://YOUR-DOMAIN/api/knet/response
KNET_ERROR_URL=https://YOUR-DOMAIN/api/knet/error

# The customer-facing KNET payment page (defaults to the kpay.com.kw one)
# KNET_PAYMENT_PAGE_URL=https://www.kpay.com.kw/kpg/paymentpage.htm

# Database and storage. DATABASE_URL should be the Supabase pooled connection URL
# for the deployed application. Use a direct connection URL only for migrations.
DATABASE_URL=
DIRECT_URL=
# Server-only Supabase project URL and service key used to issue media upload URLs.
# Do not expose SUPABASE_SERVICE_ROLE_KEY to the browser or commit it.
SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application security and initial staff account
AUTH_SECRET=
CRON_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=Store Owner

# Email notifications (selected provider to be configured before production)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Card and Apple Pay gateway: intentionally unset until a merchant-approved
# Kuwait-compatible provider is selected.
PAYMENT_PROVIDER_SECRET_KEY=
PAYMENT_PROVIDER_WEBHOOK_SECRET=
ALLOW_MOCK_PAYMENTS=false
NEXT_PUBLIC_MOCK_PAYMENTS_ENABLED=false
