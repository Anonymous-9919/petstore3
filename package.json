{
  "name": "petstore3",
  "version": "1.0.0",
  "private": true,
  "description": "Pixel-perfect replica of petstorekuwait.com (Next.js + Tailwind + shadcn/ui)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm run typecheck:scripts",
    "typecheck:scripts": "tsc --noEmit -p tsconfig.scripts.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:local": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "harvest": "node scripts/harvest.mjs",
    "assets": "node scripts/download-assets.mjs",
    "db:import-static": "dotenv -e .env.local -- tsx scripts/import-json-to-db.ts",
    "db:seed": "dotenv -e .env.local -- tsx prisma/seed.ts",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:migrate": "dotenv -e .env.local -- prisma migrate deploy",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:split-inventory": "dotenv -e .env.local -- tsx scripts/split-inventory.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-radio-group": "^1.2.2",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@supabase/supabase-js": "^2.112.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "next": "^16.3.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^6.22.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.4",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.2",
    "@playwright/test": "1.62.1",
    "playwright-core": "^1.62.1",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.1",
    "prisma": "6.12.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
